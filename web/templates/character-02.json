{
  "id": "character-02",
  "contentType": "character",
  "kind": "body",
  "label": "프로필",
  "reference": "reference/캐릭터 소개 · 02 프로필.png",
  "fonts": {
    "display": "Jua",
    "body": "Gowun Dodum"
  },
  "palette": {
    "bg": "#FFF8F0",
    "ink": "#2E2A35",
    "inkSoft": "#5A5463",
    "muted": "#8A8494",
    "accent": "#F7C6D3",
    "white": "#FFFFFF",
    "paper": "#FFF8F0"
  },
  "fields": [
    {
      "key": "character_name",
      "label": "이름",
      "type": "text",
      "max": 12,
      "required": true,
      "item": "official_name"
    },
    {
      "key": "profile_rows",
      "label": "프로필 항목",
      "type": "items",
      "maxItems": 3,
      "editor": "list",
      "unit": "개",
      "verifyItems": [
        "birthday",
        "favorite",
        "creator",
        "profile_extra",
        "official_name",
        "series",
        "debut",
        "personality"
      ],
      "fields": [
        {
          "key": "label",
          "label": "항목명",
          "type": "text",
          "max": 6,
          "required": true,
          "placeholder": "예: 타입"
        },
        {
          "key": "value",
          "label": "내용",
          "type": "text",
          "max": 16,
          "required": true,
          "placeholder": "예: 전기"
        }
      ],
      "hint": "이름을 뺀 프로필 항목. 조사 항목의 생일·좋아하는 것·제작자·기타 공식 프로필 중 출처로 확인된 것만 0~3개 고른다 (예: 도감 번호 / 타입 / 분류). 확인되지 않은 항목은 넣지 않고 '모름' 같은 빈 값도 쓰지 않는다"
    },
    {
      "key": "profile_intro",
      "label": "소개 문장",
      "type": "multiline",
      "max": 50,
      "item": "personality",
      "hint": "프로필 항목이 1개 이하일 때만 쓴다. 성격·특징 조사 항목에서 확인된 내용만 한 문장으로. 확인된 내용이 없으면 비운다"
    },
    {
      "key": "feature_tags",
      "label": "특징 태그",
      "type": "list",
      "maxItems": 3,
      "itemMax": 8,
      "item": "personality"
    },
    {
      "key": "debut_year",
      "label": "첫 등장 연도",
      "type": "text",
      "max": 8,
      "hint": "예: 2020년. 모르면 비워 두세요",
      "item": "debut"
    },
    {
      "key": "debut_work",
      "label": "첫 등장 작품·플랫폼",
      "type": "text",
      "max": 16,
      "item": "debut"
    },
    {
      "key": "profile_no",
      "label": "소개 순번 (No.)",
      "type": "text",
      "max": 6,
      "demo": "",
      "hint": "세모귀 캐릭터 소개 시리즈의 순번. 모르면 비워 두세요"
    }
  ],
